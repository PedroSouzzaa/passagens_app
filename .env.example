# --- Supabase (banco de dados) ---
# Encontre em: Supabase > seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# --- Amadeus for Developers (dados de voos) ---
# Crie uma conta gratuita (sem aprovação) em https://developers.amadeus.com/register,
# crie um app em "My Self-Service Workspace" e copie a API Key e o API Secret.
AMADEUS_API_KEY=coloque-sua-api-key-aqui
AMADEUS_API_SECRET=coloque-seu-api-secret-aqui

# --- Resend (envio de e-mail de notificação) ---
# Crie uma conta gratuita em https://resend.com/
RESEND_API_KEY=coloque-sua-chave-aqui
NOTIFY_EMAIL_FROM=alertas@seudominio.com

# --- Segurança do endpoint de cron ---
# Uma string aleatória qualquer, só você e o cron job precisam saber
CRON_SECRET=escolha-uma-senha-forte-aqui
